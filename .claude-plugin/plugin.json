{
  "name": "minnimemory",
  "displayName": "MinniMemoryMCP",
  "version": "1.4.2",
  "description": "Curated memory for Claude Code: audits your memory files and compiles them into a small always-on body plus files loaded on demand, then shows what that saved. Offline, lossless, undoable.",
  "author": {
    "name": "MinniAI",
    "email": "MinniMemory@gmail.com",
    "url": "https://minniai.com"
  },
  "homepage": "https://minniai.com",
  "repository": "https://github.com/MinniAI-com/minnimemory-plugin",
  "icon": "./logo.png",
  "documentationUrl": "https://minniai.com/minnimemorymcp/docs",
  "supportUrl": "https://github.com/MinniAI-com/minnimemory-plugin/issues",
  "privacyPolicyUrl": "https://minniai.com/privacy",
  "termsOfServiceUrl": "https://minniai.com/terms",
  "keywords": [
    "memory",
    "context",
    "tokens",
    "claude-md",
    "mcp"
  ],
  "mcpServers": {
    "minnimemory": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/cli.mjs",
        "mcp"
      ]
    }
  }
}
